CONFIG_APP_ENABLE=y
CONFIG_APP_PRIORITY=1
CONFIG_APP_STACKSIZE=350

# Stock Multi-ranger driver off: src/cavebat_multiranger.c is built in its
# place (same driver, more robust init; see its header for why). Enabling this
# as well would register two drivers for the same deck.
CONFIG_DECK_MULTIRANGER=n

# Kconfig fragment. The result is cached in build/.config, so an edit here does
# not take effect on the next plain make. After changing it:
#     rm -rf build && make
# Check with: grep MULTIRANGER build/include/generated/autoconf.h
