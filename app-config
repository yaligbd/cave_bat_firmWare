CONFIG_APP_ENABLE=y
CONFIG_APP_PRIORITY=1
CONFIG_APP_STACKSIZE=350

# The Multi-ranger driver is ENABLED (this is the firmware default).
#
# It was excluded for a while because the deck's five sensors failed to
# initialise on every boot, which stops the whole firmware starting. That was
# NOT a fault with the deck. Every one of those boots followed a WARM reset --
# cfloader's -w option reboots the processor without power-cycling the deck,
# and the deck's I/O expander does not come back from a soft reset.
#
# After a genuine power cycle the expander answers every probe, including the
# firmware's own pca95x4Test().
#
# So: after flashing, POWER-CYCLE the drone before flying. A warm reboot can
# leave the deck unresponsive and the drone will refuse to start.

