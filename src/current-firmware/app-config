CONFIG_APP_ENABLE=y
CONFIG_APP_PRIORITY=1
CONFIG_APP_STACKSIZE=350

# The stock Multi-ranger driver is OUT, and src/cavebat_multiranger.c is built
# in its place: the same driver with a robust init. See the header of that file
# for why. Turning this back on would register two drivers for the same deck.
CONFIG_DECK_MULTIRANGER=n

